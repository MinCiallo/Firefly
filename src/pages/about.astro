---

import { getEntry, render } from "astro:content";
import Markdown from "@components/common/Markdown.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const aboutPost = await getEntry("spec", "about");

if (!aboutPost) {
	throw new Error("About page content not found");
}

const { Content } = await render(aboutPost);
---
<MainGridLayout title={i18n(I18nKey.about)} description={i18n(I18nKey.about)}>
    <div class="flex flex-col gap-6 w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </div>

        <!-- GitHub 贡献图 -->
        <div class="card-base z-10 px-9 py-6 relative w-full">
            <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-3">
                    <svg class="w-6 h-6 text-neutral-700 dark:text-neutral-300" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" clip-rule="evenodd"/></svg>
                    <div>
                        <h3 class="text-lg font-bold text-neutral-900 dark:text-neutral-100">GitHub 贡献</h3>
                        <div id="gh-total" class="text-sm text-neutral-500 dark:text-neutral-400"></div>
                    </div>
                </div>
                <a href="https://github.com/MinCiallo" target="_blank" rel="noopener" class="text-xs text-(--primary) hover:underline shrink-0">@MinCiallo →</a>
            </div>
            <div id="gh-content" class="flex flex-col gap-3">
                <div id="gh-loading" class="flex justify-center">
                    <div class="flex gap-px">
                      {Array.from({ length: 52 }).map(() => (
                        <div class="flex flex-col gap-px shrink-0">
                          {Array.from({ length: 7 }).map(() => (
                            <div class="w-3 h-3 rounded-sm bg-(--primary)/10 animate-pulse"></div>
                          ))}
                        </div>
                      ))}
                    </div>
                </div>
                <div id="gh-loaded" class="hidden">
                    <div class="flex items-start gap-1.5 justify-center">
                        <!-- 星期标签 -->
                        <div class="flex flex-col gap-px pt-0.5 pr-1.5">
                            <span class="text-[10px] text-neutral-400 leading-[12px]">&nbsp;</span>
                            <span class="text-[10px] text-neutral-400 leading-[12px]">二</span>
                            <span class="text-[10px] text-neutral-400 leading-[12px]">&nbsp;</span>
                            <span class="text-[10px] text-neutral-400 leading-[12px]">四</span>
                            <span class="text-[10px] text-neutral-400 leading-[12px]">&nbsp;</span>
                            <span class="text-[10px] text-neutral-400 leading-[12px]">六</span>
                            <span class="text-[10px] text-neutral-400 leading-[12px]">&nbsp;</span>
                        </div>
                        <div id="gh-grid" class="flex gap-px overflow-x-auto pb-1"></div>
                    </div>
                    <!-- 图例 -->
                    <div class="flex items-center gap-1.5 mt-2 justify-end text-[10px] text-neutral-400">
                        <span>少</span>
                        <div class="w-3 h-3 rounded-sm" style="background-color:color-mix(in srgb, var(--primary) 6%, transparent)"></div>
                        <div class="w-3 h-3 rounded-sm" style="background-color:color-mix(in srgb, var(--primary) 20%, transparent)"></div>
                        <div class="w-3 h-3 rounded-sm" style="background-color:color-mix(in srgb, var(--primary) 45%, transparent)"></div>
                        <div class="w-3 h-3 rounded-sm" style="background-color:color-mix(in srgb, var(--primary) 72%, transparent)"></div>
                        <div class="w-3 h-3 rounded-sm" style="background-color:var(--primary)"></div>
                        <span>多</span>
                    </div>
                </div>
                <div id="gh-error" class="hidden text-xs text-neutral-400 text-center py-4">
                    无法获取贡献数据
                </div>
            </div>
        </div>
    </div>
</MainGridLayout>

<script is:inline>
  const GH_API_URL = "https://api.minciallo.top";

  const MIX_AMOUNTS = [6, 20, 45, 72, 100];

  function ghGetLevel(count) {
    if (count === 0) return 0;
    if (count <= 3) return 1;
    if (count <= 6) return 2;
    if (count <= 9) return 3;
    return 4;
  }

  function ghRenderHeatmap(weeks) {
    const recentWeeks = weeks.slice(-52);

    let html = "";
    for (const week of recentWeeks) {
      html += '<div class="flex flex-col gap-px shrink-0">';
      for (const day of week.contributionDays) {
        const level = ghGetLevel(day.contributionCount);
        const amt = MIX_AMOUNTS[level];
        html += `<div class="w-3 h-3 rounded-sm transition-transform hover:scale-125 hover:z-10" style="background-color:color-mix(in srgb, var(--primary) ${amt}%, transparent)" title="${day.date}: ${day.contributionCount} contributions"></div>`;
      }
      html += "</div>";
    }
    return html;
  }

  async function ghLoadContributions() {
    const loading = document.getElementById("gh-loading");
    const loaded = document.getElementById("gh-loaded");
    const error = document.getElementById("gh-error");
    const grid = document.getElementById("gh-grid");
    const total = document.getElementById("gh-total");
    if (!loading || !loaded || !error || !grid || !total) return;

    try {
      const res = await fetch(`${GH_API_URL}/api/github/contributions`);
      const data = res.ok ? await res.json() : null;
      const calendar = data?.data?.user?.contributionsCollection?.contributionCalendar;
      const weeks = calendar?.weeks;
      if (!weeks || !weeks.length) throw new Error("No data");

      loading.classList.add("hidden");
      loaded.classList.remove("hidden");

      grid.innerHTML = ghRenderHeatmap(weeks);

      const totalContributions = weeks.reduce(
        (sum, w) => sum + w.contributionDays.reduce((s, d) => s + d.contributionCount, 0),
        0
      );
      total.textContent = `过去一年共 ${totalContributions} 次贡献`;
    } catch (err) {
      loading.classList.add("hidden");
      error.classList.remove("hidden");
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", ghLoadContributions);
  } else {
    ghLoadContributions();
  }
  document.addEventListener("swup:contentReplaced", () => {
    setTimeout(ghLoadContributions, 200);
  });
</script>
<style is:global>
    [data-lqip] img { transition: opacity .35s ease; }
    [data-lqip] img.lqip-pending { opacity: 0; }
    @media (prefers-reduced-motion: reduce) { [data-lqip] img { transition: none; } }
</style>
<script>
    function initImagePreviews() {
        document.querySelectorAll<HTMLImageElement>('[data-lqip] img:not(.fallback-image img)').forEach(image => {
            if (image.dataset.previewBound || (image.complete && image.naturalWidth > 0)) return;
            image.dataset.previewBound = "true";
            image.classList.add("lqip-pending");
            const reveal = () => image.classList.remove("lqip-pending");
            image.addEventListener("load", reveal, { once: true });
            image.addEventListener("error", reveal, { once: true });
            if (image.complete) reveal();
        });
    }
    initImagePreviews();
    document.addEventListener("astro:page-load", initImagePreviews);
    document.addEventListener("swup:contentReplaced", initImagePreviews);
</script>

---
import WidgetLayout from "@/components/common/WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
}
const { class: className, style } = Astro.props;
---

<WidgetLayout name="最近在听" class={className} style={style}>
  <div id="lastfm-widget" class="flex flex-col">
    <div class="text-xs text-neutral-400 text-center py-3">加载中...</div>
  </div>
</WidgetLayout>

<script>
  const LFM_API = "https://api.minciallo.top";

  function timeAgo(uts) {
    const diff = Math.floor((Date.now() / 1000) - uts);
    if (diff < 60) return "刚刚";
    if (diff < 3600) return Math.floor(diff / 60) + " 分钟前";
    if (diff < 86400) return Math.floor(diff / 3600) + " 小时前";
    if (diff < 2592000) return Math.floor(diff / 86400) + " 天前";
    const d = new Date(uts * 1000);
    return d.getMonth() + 1 + "/" + d.getDate();
  }

  function getImage(track) {
    if (track?.albumArt) return track.albumArt;
    const img = track?.image?.find(i => i.size === "extralarge") || track?.image?.find(i => i.size === "large");
    return img?.["#text"] || "";
  }

  // QQ 音乐封面查询：iTunes 匹配常出错（同名歌返回其他歌手专辑），Last.fm CDN 大陆不可达，
  // 故优先用 QQ 音乐 JSONP 接口按「歌手 + 歌名」查专辑封面（国内 CDN，稳定可达）
  const QQ_COVER_BASE = "https://y.gtimg.cn/music/photo_new/T002R300x300M000";
  let qqCoverSeq = 0;

  function qqCoverLookup(artist, song) {
    const key = "qq-cover:" + artist + "|" + song;
    try {
      const cached = JSON.parse(localStorage.getItem(key) || "null");
      if (cached && Date.now() - cached.t < (cached.mid ? 14 : 1) * 86400000) {
        return Promise.resolve(cached.mid ? QQ_COVER_BASE + cached.mid + ".jpg" : "");
      }
    } catch (e) {}

    return new Promise((resolve) => {
      const cb = "qqCoverCb" + (++qqCoverSeq) + "_" + Date.now();
      const timer = setTimeout(() => { cleanup(); resolve(""); }, 6000);
      function cleanup() {
        clearTimeout(timer);
        try { delete window[cb]; } catch (e) { window[cb] = undefined; }
        const el = document.getElementById(cb);
        if (el) el.remove();
      }
      window[cb] = function (res) {
        cleanup();
        let mid = "";
        const list = (res && res.data && res.data.song && res.data.song.list) || [];
        for (const item of list) {
          if (item && item.albummid) { mid = item.albummid; break; }
        }
        try { localStorage.setItem(key, JSON.stringify({ mid: mid, t: Date.now() })); } catch (e) {}
        resolve(mid ? QQ_COVER_BASE + mid + ".jpg" : "");
      };
      const script = document.createElement("script");
      script.id = cb;
      script.src = "https://c.y.qq.com/soso/fcgi-bin/client_search_cp?format=jsonp&jsonpCallback=" + cb + "&n=5&w=" + encodeURIComponent((artist || "") + " " + (song || ""));
      document.head.appendChild(script);
    });
  }

  async function loadLastFm() {
    const container = document.getElementById("lastfm-widget");
    if (!container) return;

    try {
      const res = await fetch(`${LFM_API}/api/lastfm/recent`);
      const data = res.ok ? await res.json() : null;
      const tracks = data?.recenttracks?.track;
      if (!tracks || !tracks.length) {
        container.innerHTML = '<div class="text-xs text-neutral-400 text-center py-3">暂无播放记录</div>';
        return;
      }

      const np = !tracks[0].date ? tracks[0] : null;
      const recent = np ? tracks.slice(1, 4) : tracks.slice(0, 3);

      // 并行解析 QQ 音乐封面，失败时回退 albumArt / Last.fm 图
      const coverMap = new Map();
      await Promise.all([...(np ? [np] : []), ...recent].map(async (t) => {
        const cover = await qqCoverLookup(t.artist?.["#text"] || "", t.name || "");
        coverMap.set(t, cover || getImage(t));
      }));

      let html = "";

      // 正在播放
      if (np) {
        const img = coverMap.get(np);
        html += `
          <div class="mb-2.5">
            <div class="flex items-center gap-1 mb-1.5">
              <span class="inline-block w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
              <span class="text-[11px] font-medium text-green-500">正在播放</span>
            </div>
            <a href="${np.url || '#'}" target="_blank" rel="noopener"
               class="flex items-center gap-2.5 py-1.5 px-2 -mx-2 rounded-lg group hover:bg-(--primary)/5 transition">
              ${img ? `<img src="${img}" alt="${np.name}" class="h-10 w-10 rounded-lg object-cover shrink-0 shadow-sm" onerror="this.remove()" />` : ""}
              <div class="flex-1 min-w-0">
                <div class="text-sm font-medium text-neutral-800 dark:text-neutral-200 truncate group-hover:text-(--primary) transition">
                  ${np.name || "未知歌曲"}
                </div>
                <div class="text-xs text-neutral-400 truncate mt-0.5">
                  ${np.artist?.["#text"] || "未知艺术家"}
                </div>
              </div>
            </a>
          </div>`;
      }

      // 最近播放（紧凑列表）
      if (recent.length > 0) {
        html += `<div class="${np ? "border-t border-(--line-divider) pt-2" : ""}">`;
        recent.forEach((t, i) => {
          const imgSrc = coverMap.get(t);
          if (imgSrc) {
            html += `<a href="${t.url || '#'}" target="_blank" rel="noopener"
               class="flex items-center gap-2 py-1.5 px-1.5 -mx-1.5 rounded-md group hover:bg-(--primary)/5 transition">
              <span class="text-[10px] text-neutral-400 w-4 text-right shrink-0">${i + 1}</span>
              <img src="${imgSrc}" alt="${t.name}" class="h-8 w-8 rounded-md object-cover shrink-0 bg-neutral-100 dark:bg-neutral-800" onerror="this.remove()" />
              <div class="flex-1 min-w-0">
                <div class="text-xs font-medium text-neutral-700 dark:text-neutral-300 truncate group-hover:text-(--primary) transition">${t.name || "未知歌曲"}</div>
                <div class="text-[11px] text-neutral-400 truncate">${t.artist?.["#text"] || ""}</div>
              </div>
              ${t.date ? '<span class="text-[10px] text-neutral-400 shrink-0 ml-1">' + timeAgo(t.date.uts) + '</span>' : ""}
            </a>`;
          } else {
            html += `<a href="${t.url || '#'}" target="_blank" rel="noopener"
               class="flex items-center gap-2 py-1.5 px-1.5 -mx-1.5 rounded-md group hover:bg-(--primary)/5 transition">
              <span class="text-[10px] text-neutral-400 w-4 text-right shrink-0">${i + 1}</span>
              <div class="flex-1 min-w-0">
                <div class="text-xs font-medium text-neutral-700 dark:text-neutral-300 truncate group-hover:text-(--primary) transition">${t.name || "未知歌曲"}</div>
                <div class="text-[11px] text-neutral-400 truncate">${t.artist?.["#text"] || ""}</div>
              </div>
              ${t.date ? '<span class="text-[10px] text-neutral-400 shrink-0 ml-1">' + timeAgo(t.date.uts) + '</span>' : ""}
            </a>`;
          }
        });
        html += "</div>";
      }

      container.innerHTML = html;

      // 查看全部
      container.insertAdjacentHTML("beforeend", `
        <a href="/music/" class="flex items-center justify-center gap-1 pt-2 mt-1 text-xs text-neutral-400 hover:text-(--primary) transition border-t border-(--line-divider)">
          查看全部
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      `);

    } catch (err) {
      container.innerHTML = '<div class="text-xs text-neutral-400 text-center py-3">加载失败</div>';
    }
  }

  // 初始化
  function initLastFm() {
    loadLastFm();
  }

  window.__initLastFm = initLastFm;

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initLastFm);
  } else {
    initLastFm();
  }
  document.addEventListener("swup:contentReplaced", () => {
    setTimeout(initLastFm, 200);
  });
</script>